# ── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL:  postgres://postgres:yourpassword@localhost:5432/restaurant
# Free cloud DB:     https://neon.tech  or  https://supabase.com
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/restaurant

# SSL is enabled automatically for remote hosts and disabled for localhost.
# Some hosted providers use self-signed certs and need verification turned off:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Set to 'true' to keep serving from the in-memory store if Postgres is unreachable.
# Leave unset in production — the data is lost on restart.
ALLOW_MEMORY_FALLBACK=false

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. The server refuses to start in production without it.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Seed manager account. MANAGER_PASSWORD is REQUIRED in production —
# the default ('manager123') is public in this repository.
MANAGER_EMAIL=manager@restaurant.com
MANAGER_PASSWORD=choose_a_strong_password

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password for "Mail"
# 3. Paste it in MAIL_SMTP_PASS (no spaces)
# Leave these BLANK until you have a real Gmail App Password. Blank is fine — the app
# runs normally and simply logs that mail is not configured. Placeholder values are
# rejected on purpose, so they cannot slow the app down with doomed login attempts.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
# WHATSAPP_PHONE_NUMBER_ID is the numeric ID shown there, NOT the phone number.
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Country code prepended to local numbers stored without one (91 = India)
WHATSAPP_DEFAULT_COUNTRY=91

# Names of your APPROVED templates in the Meta dashboard
WHATSAPP_TEMPLATE_REMINDER=reservation_reminder
WHATSAPP_TEMPLATE_CONFIRMATION=reservation_confirmed
WHATSAPP_TEMPLATE_ORDER=order_confirmation
WHATSAPP_TEMPLATE_LANG=en

WHATSAPP_TEMPLATE_LOW_STOCK=low_stock_alert

# ── Notifications ────────────────────────────────────────────────────────────
# How many minutes before a reservation the reminder goes out (default 120)
REMINDER_LEAD_MINUTES=120

# Where manager alerts go (low stock). Leave both blank to switch the alerts off.
MANAGER_ALERT_EMAIL=
MANAGER_ALERT_PHONE=

# ── AI models ────────────────────────────────────────────────────────────────
# AI_MODE=local   run DistilBERT and bart-large-mnli on this machine (recommended)
# AI_MODE unset   use the keyword classifier
#
# Local mode needs no API key. The first analysis downloads the model weights
# (~65 MB + ~400 MB) and caches them, so that one call is slow and needs internet.
# Everything after runs offline.
AI_MODE=local

# Hugging Face's hosted API no longer serves these two models — it answers
# "Model not supported by provider hf-inference". Kept only as a fallback in case
# they restore support.
HUGGINGFACE_API_KEY=

# Only set this if Hugging Face moves the endpoint again.
# HF_API_BASE=https://router.huggingface.co/hf-inference/models

# Defaults match the Module 5 specification; override only if you know why.
# HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
# HF_ZEROSHOT_MODEL=facebook/bart-large-mnli

# SST-2 has no neutral class, so anything scoring below this is recorded as NEUTRAL.
# HF_NEUTRAL_THRESHOLD=0.75
# Minimum zero-shot score for a category to be attached to a review.
# HF_CATEGORY_THRESHOLD=0.5

# ── Payments ─────────────────────────────────────────────────────────────────
# Used to sign and verify payment webhooks. Change this for anything public.
PAYMENT_WEBHOOK_SECRET=change_this_to_a_long_random_string

# The address customers reach on their phone. Must NOT be localhost if you want the
# QR code to work from a phone — use your PC's LAN address, e.g. http://192.168.1.5:5000
PUBLIC_BASE_URL=http://localhost:5000

WHATSAPP_TEMPLATE_RECEIPT=payment_receipt
WHATSAPP_TEMPLATE_TABLE_READY=table_ready

# ── Legacy Twilio WhatsApp (only if WHATSAPP_PROVIDER=twilio) ────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
# TWILIO_FROM_SMS=
